# TANVEER PRIME — example configuration. PLACEHOLDERS ONLY: never commit a real .env.
# The installer writes the real file to /etc/tanveer-prime/tanveer-prime.env (root-only, mode 600).
# For local development copy this to .env (it is git-ignored) and fill in your own values.
# MADE BY TANVEER | DISCORD: TANVEER5637

# --- Required -----------------------------------------------------------------
DISCORD_TOKEN="paste-your-bot-token-here"
DISCORD_CLIENT_ID="your-application-id"

# --- Optional: instant slash-command updates in ONE test server (otherwise commands register globally, which can take up to an hour) ---
DEV_GUILD_ID=""

# --- Storage / logging --------------------------------------------------------
DATA_DIR="./data"            # SQLite database + backups live here
LOG_LEVEL="info"             # error | warn | info | debug
BOT_NAME="TANVEER PRIME"     # display name only; the creator attribution is permanent and not configurable

# --- Privileged intents (must ALSO be enabled in the Developer Portal → Bot) ---
ENABLE_MESSAGE_CONTENT="true"   # needed for ! prefix commands, automod and XP
ENABLE_GUILD_MEMBERS="true"     # needed for welcome messages, member logs, autoroles

# --- Dashboard (optional) -----------------------------------------------------
DASHBOARD_ENABLED="false"
DASHBOARD_HOST="127.0.0.1"                 # keep on localhost; publish through an HTTPS reverse proxy
DASHBOARD_PORT="3000"
DASHBOARD_BASE_URL="http://localhost:3000"  # OAuth2 redirect = <BASE_URL>/auth/callback (add it in the Developer Portal)
DASHBOARD_TRUST_PROXY="false"               # set true only behind your own reverse proxy
DISCORD_CLIENT_SECRET="your-oauth2-client-secret"
SESSION_SECRET="long-random-string"         # auto-generated by the installer if missing

# --- Music (optional; without Lavalink the music commands explain that music is unavailable) ---
LAVALINK_HOST=""
LAVALINK_PORT="2333"
LAVALINK_PASSWORD="your-lavalink-password"
LAVALINK_SECURE="false"
LAVALINK_NAME="main"
